MOCK_MODE=true

# Optional LLM configuration (NOT required for demo)
# Gemini key is not required in this project.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDINGS_MODEL=text-embedding-3-small

# Optional Qdrant configuration
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=devvoice_context
MAX_CONTEXT_CHUNKS=6

# Optional Vapi browser configuration
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Recommended in production: stable random secret for signed anonymous visitor scope
DEVVOICE_VISITOR_SECRET=
